{
  "name": "cvstudio-apollo",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {"PUBLIC_ORIGIN": "https://cvstudio-apollo.YOUR-SUBDOMAIN.workers.dev"},
  "d1_databases": [{"binding": "DB", "database_name": "cvstudio-apollo", "database_id": "REPLACE-AFTER-CREATING-DATABASE"}],
  "triggers": {"crons": ["17 3 * * *"]}
}
